# ── PHP / app ──
/app/vendor/
/app/var/
/app/.phpunit.cache/
/app/.php-cs-fixer.cache

# ── Python / data ──
/data/.venv/
*.egg-info/
/data/.mutmut-cache
/data/mutants/
**/__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Infra / déploiement ──
/infra/.venv/

# Clés de déploiement : elles vivent dans ~/.ssh et dans GitHub Secrets.
# Une clé committée reste dans l'historique : il faut la révoquer, pas l'effacer.
id_rsa
id_dsa
id_ecdsa
id_ed25519*
*.pem
*.ppk

# ── Environnement ──
# Les vraies variables (dont VV_MOTEUR_*) restent locales ; `.env.example` est suivi.
.env
.env.local

# ── Divers ──
.DS_Store
.idea/
