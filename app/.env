# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
# Domaine de base : sous-domaines app./admin./widget. (dev : *.localhost résout vers 127.0.0.1).
APP_DOMAINE=valeurverte.localhost
# Proxies de confiance (when@prod) : vide = ne fait confiance à personne, correct en
# dev où l'app est jointe en direct. En production, le compose injecte « REMOTE_ADDR »
# car l'app n'est joignable qu'à travers le reverse proxy.
TRUSTED_PROXIES=
# Bascule maintenance (#197) : 1 = coupe les zones publique/pro en 503 (page
# habillée), l'admin reste accessible. 0 en fonctionnement normal.
APP_MAINTENANCE=0
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Base PostGIS partagée avec le pipeline `data`. L'app se connecte avec le rôle
# applicatif « app » : écriture sur le schéma `app`, lecture seule sur `data`
# (grants posés à l'init de la base). Le search_path=app est porté par le rôle.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/valeur_verte?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> brevo (email transactionnel #108) — clé réelle dans .env.local ###
BREVO_API_KEY=
BREVO_EXPEDITEUR=no-reply@valeur-verte.fr
# Adresse de réponse des emails non transactionnels (relance conversationnelle
# #109) : boîte réelle relevée, pour que l'artisan puisse répondre au mail
# envoyé après son premier rapport.
CONTACT_REPONSE=contact@valeur-verte.fr
###< brevo ###

###> cloudflare/turnstile ###
# Anti-abus du widget (#43, contrôle 2). Vides = Turnstile désactivé (inerte) :
# le défi n'est pas rendu et la vérification serveur est un no-op. Renseigner
# TURNSTILE_SITE_KEY (publique, rendue dans le formulaire) et TURNSTILE_SECRET
# (secrète, vérification siteverify) via l'environnement pour l'activer.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
###< cloudflare/turnstile ###

###> app/seo-presence ###
# Présence SEO externe (#346). Toutes vides = collecte désactivée (inerte) : la
# commande app:seo:presence:fetch signale « non configurée » et n'archive rien, la
# section admin affiche « non configuré ». Renseigner via .env.local / secrets du VPS
# une fois le domaine en ligne et la propriété Search Console vérifiée.
# - PAGESPEED_API_KEY : clé API Google (PageSpeed Insights, Core Web Vitals).
# - Auth Search Console par OAuth utilisateur (les clés de compte de service sont
#   bloquées par une règle d'org Google). Créer un client OAuth « Desktop », faire une
#   fois le consentement avec le compte ayant accès à la propriété, récupérer le
#   refresh token, puis renseigner (secrets → .env.local / VPS, jamais ici) :
#   GSC_OAUTH_CLIENT_ID / GSC_OAUTH_CLIENT_SECRET / GSC_OAUTH_REFRESH_TOKEN.
# - GSC_SITE_URL : propriété Search Console — « sc-domain:valeur-verte.fr » (domaine)
#   ou « https://valeur-verte.fr/ » (préfixe d'URL).
PAGESPEED_API_KEY=
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=
GSC_SITE_URL=
###< app/seo-presence ###
