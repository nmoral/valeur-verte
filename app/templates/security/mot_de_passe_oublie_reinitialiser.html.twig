<!DOCTYPE html>
<html lang="fr">
<head>
{{ include('_seo.html.twig', {
  titre: 'Nouveau mot de passe · Valeur Verte',
  description: 'Choisissez un nouveau mot de passe pour votre espace Valeur Verte.',
  canonical: url('mot_de_passe_oublie_reinitialiser'),
  robots: 'noindex,nofollow',
}) }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/auth.css') }}">
</head>
<body>
<main class="auth">
  <a href="/" class="auth-brand"><i aria-hidden="true">VV</i> Valeur Verte</a>

  <div class="auth-card">
    <h1>Nouveau mot de passe</h1>
    <p class="auth-lead">Choisissez un nouveau mot de passe pour votre compte.</p>

    {% if erreurs.global is defined %}
      <p class="alert" role="alert">{{ erreurs.global }}</p>
    {% endif %}

    <form method="post" action="{{ path('mot_de_passe_oublie_reinitialiser') }}" novalidate>
      <div class="field-group{{ erreurs.password is defined ? ' has-error' : '' }}">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" autocomplete="new-password" required autofocus>
        {% if erreurs.password is defined %}
          <span class="form-error">{{ erreurs.password }}</span>
        {% else %}
          <span class="hint">Au moins 8 caractères.</span>
        {% endif %}
      </div>

      <input type="hidden" name="jeton" value="{{ jeton }}">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('reinitialisation') }}">
      <button type="submit" class="btn-primary">Définir le mot de passe</button>
    </form>
  </div>

  <p class="auth-legal">Estimation statistique — ne constitue pas une évaluation immobilière.</p>
</main>
</body>
</html>
