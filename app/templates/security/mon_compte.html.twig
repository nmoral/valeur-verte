{# Page servie dans les deux zones (#306) : les URL se génèrent sur la route
   effectivement empruntée, sinon le formulaire de l'admin posterait vers app.
   Une réponse 422 rendue depuis une action POST (changement d'adresse, #310)
   passe la route explicitement : l'attribut de requête désigne alors l'action,
   pas la page. #}
{% set route_compte = route_compte|default(app.request.attributes.get('_route')) %}
{% set route_email = route_compte == 'mon_compte_admin' ? 'mon_compte_email_admin' : 'mon_compte_email' %}
{% set erreursEmail = erreursEmail|default({}) %}
<!DOCTYPE html>
<html lang="fr">
<head>
{{ include('_seo.html.twig', {
  titre: 'Mon compte · Valeur Verte',
  description: 'Gérez votre compte Valeur Verte et changez votre mot de passe.',
  canonical: url(route_compte),
  robots: 'noindex,nofollow',
}) }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/auth.css') }}">
</head>
<body>
<main class="auth">
  <a href="/" class="auth-brand"><i aria-hidden="true">VV</i> Valeur Verte</a>

  <div class="auth-card">
    <h1>Mon compte</h1>
    <p class="auth-lead">Connecté en tant que <strong>{{ app.user.email }}</strong>.</p>

    {% for message in app.flashes('mon_compte') %}
      <p class="alert-ok" role="status">{{ message }}</p>
    {% endfor %}

    {% if erreurs.global is defined %}
      <p class="alert" role="alert">{{ erreurs.global }}</p>
    {% endif %}

    {% if erreursEmail.global is defined %}
      <p class="alert" role="alert">{{ erreursEmail.global }}</p>
    {% endif %}

    <h2>Changer mon mot de passe</h2>
    <form method="post" action="{{ path(route_compte) }}" novalidate>
      <div class="field-group{{ erreurs.actuel is defined ? ' has-error' : '' }}">
        <label for="actuel">Mot de passe actuel</label>
        <input type="password" id="actuel" name="actuel" autocomplete="current-password" required autofocus>
        {% if erreurs.actuel is defined %}<span class="form-error">{{ erreurs.actuel }}</span>{% endif %}
      </div>

      <div class="field-group{{ erreurs.nouveau is defined ? ' has-error' : '' }}">
        <label for="nouveau">Nouveau mot de passe</label>
        <input type="password" id="nouveau" name="nouveau" autocomplete="new-password" required>
        {% if erreurs.nouveau is defined %}
          <span class="form-error">{{ erreurs.nouveau }}</span>
        {% else %}
          <span class="hint">Au moins 8 caractères.</span>
        {% endif %}
      </div>

      <div class="field-group{{ erreurs.confirmation is defined ? ' has-error' : '' }}">
        <label for="confirmation">Confirmer le nouveau mot de passe</label>
        <input type="password" id="confirmation" name="confirmation" autocomplete="new-password" required>
        {% if erreurs.confirmation is defined %}<span class="form-error">{{ erreurs.confirmation }}</span>{% endif %}
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('mon_compte') }}">
      <button type="submit" class="btn-primary">Changer le mot de passe</button>
    </form>

    {# Changement d'adresse (#310) : l'adresse est l'identifiant de connexion et
       le canal de récupération — elle ne bascule qu'après confirmation sur la
       nouvelle boîte, et l'ancienne en est avertie. #}
    <h2>Changer mon adresse email</h2>
    <p>
      Votre adresse actuelle reste active tant que vous n'avez pas cliqué le lien
      de confirmation envoyé à la nouvelle.
    </p>
    <form method="post" action="{{ path(route_email) }}" novalidate>
      <div class="field-group{{ erreursEmail.nouvel_email is defined ? ' has-error' : '' }}">
        <label for="nouvel_email">Nouvelle adresse email</label>
        <input type="email" id="nouvel_email" name="nouvel_email" autocomplete="email" required>
        {% if erreursEmail.nouvel_email is defined %}
          <span class="form-error">{{ erreursEmail.nouvel_email }}</span>
        {% endif %}
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('mon_compte_email') }}">
      <button type="submit" class="btn-primary">Envoyer le lien de confirmation</button>
    </form>

    {# Résiliation self-service (#308) : réservée au pro (l'admin interne, sans
       tenant, honore une demande d'effacement depuis /comptes, pas ici). #}
    {% if app.user.tenantId is not null %}
      <h2>Supprimer mon compte</h2>
      <p>Vous pouvez résilier et faire effacer votre compte sans contact humain.</p>
      <p><a href="{{ path('compte_suppression') }}">Supprimer mon compte</a></p>
    {% endif %}
  </div>

  <p class="auth-alt"><a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin' : 'espace_pro') }}">Retour à mon espace</a></p>
  <p class="auth-legal">Estimation statistique — ne constitue pas une évaluation immobilière.</p>
</main>
</body>
</html>
