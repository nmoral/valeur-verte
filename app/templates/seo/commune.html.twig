<!DOCTYPE html>
<html lang="fr">
<head>
{{ include('_seo.html.twig', {
  titre: 'Valeur verte ' ~ commune_nom ~ ' (' ~ departement_nom ~ ') : la plus-value d\'un meilleur DPE',
  og_titre: 'Valeur verte ' ~ commune_nom,
  description: 'La valeur verte à ' ~ commune_nom ~ ' (' ~ departement_nom ~ ') : le gain de prix qu\'un meilleur DPE ajoute à une maison, mesuré sur les ventes réellement enregistrées par les notaires (DVF) croisées aux DPE de l\'ADEME.',
  canonical: url('commune_valeur_verte', { departement: departement_slug, commune: commune_slug }),
  robots: fiche.indexabilite.directiveRobots,
}) }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/landing.css') }}">
<link rel="stylesheet" href="{{ asset('css/footer.css') }}">
<style>
  .hero .wrap{grid-template-columns:1fr}
  .hero .lead{max-width:64ch}
  .block h2{font:800 26px/1.1 'Archivo',sans-serif;letter-spacing:-.02em;margin-bottom:16px}
  .block p{max-width:72ch;color:var(--slate);margin-bottom:14px}
  .chiffres{display:flex;flex-wrap:wrap;gap:28px;margin:22px 0}
  .chiffres b{display:block;font:800 30px/1 'Archivo',sans-serif;letter-spacing:-.02em}
  .chiffres span{font-size:13px;color:var(--slate)}
  .grille-dpe{width:100%;max-width:560px;border-collapse:collapse;margin:18px 0;font-size:15px}
  .grille-dpe th,.grille-dpe td{padding:8px 12px;border-bottom:1px solid var(--rule);text-align:left}
  .grille-dpe td.val{text-align:right;font-variant-numeric:tabular-nums}
  .source{max-width:72ch;margin:20px 0;padding:12px 16px;background:var(--card);border:1px solid var(--rule);border-radius:3px;font-size:14px;color:var(--slate)}
</style>
{% set prix_par_classe = fiche.prixM2ParClasse %}
{% set donnees_structurees = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Valeur verte ' ~ commune_nom,
  'url': url('commune_valeur_verte', { departement: departement_slug, commune: commune_slug }),
  'inLanguage': 'fr-FR',
  'about': {
    '@type': 'Place',
    'name': commune_nom,
    'containedInPlace': { '@type': 'Place', 'name': departement_nom }
  },
  'isPartOf': { '@type': 'WebSite', 'name': 'Valeur Verte', 'url': url('home') }
} %}
<script type="application/ld+json">{{ donnees_structurees|json_encode|raw }}</script>
</head>
<body>

<a href="#contenu" class="sr-only">Aller au contenu principal</a>

<nav class="nav" aria-label="Navigation principale">
  <div class="wrap">
    <a href="{{ url('home') }}" class="brand" data-lien="accueil"><i aria-hidden="true">VV</i> Valeur Verte</a>
    <ul class="nav-menu">
      <li class="nav-link"><a href="{{ url('carte_nationale') }}">La carte de France</a></li>
      <li class="nav-link"><a href="{{ path('publication') }}">L'étude</a></li>
      <li><a href="{{ path('login') }}" class="btn btn-ghost btn-sm">Connexion</a></li>
      <li class="nav-cta"><a href="{{ url('inscription') }}" class="btn btn-sm" data-lien="inscription">Créer un compte</a></li>
    </ul>
  </div>
</nav>

<main id="contenu">

  {% set niveaux = [
    { nom: 'Accueil', url: url('home') },
    { nom: departement_nom, url: url('hub_departemental', { departement: departement_slug }) },
  ] %}
  {% if epci_slug %}{% set niveaux = niveaux|merge([{ nom: epci_nom, url: url('hub_epci', { epci: epci_slug }) }]) %}{% endif %}
  {% set niveaux = niveaux|merge([{ nom: commune_nom, url: url('commune_valeur_verte', { departement: departement_slug, commune: commune_slug }) }]) %}
  {{ include('seo/_fil_ariane.html.twig', { niveaux: niveaux }) }}

  <header class="hero">
    <div class="wrap">
      <div>
        <p class="kicker">Valeur verte · {{ commune_nom }} · {{ departement_nom }}</p>
        <h1>La plus-value d'un meilleur DPE à <span>{{ commune_nom }}</span>.</h1>
        <p class="lead">Combien un saut de classe énergétique ajoute-t-il à la valeur d'une maison à
          {{ commune_nom }}&nbsp;? Le chiffre mesuré sur les ventes réellement enregistrées par les
          notaires, croisées aux DPE — pas une moyenne nationale.</p>
        <div class="cta-row">
          <a href="{{ url('inscription') }}" class="btn" data-lien="inscription">Estimer un bien</a>
          {% if epci_slug %}
            <a href="{{ url('hub_epci', { epci: epci_slug }) }}" class="btn btn-ghost">Voir {{ epci_nom }}</a>
          {% endif %}
          <a href="{{ url('hub_departemental', { departement: departement_slug }) }}" class="btn btn-ghost">Voir tout le département</a>
        </div>
      </div>
    </div>
  </header>

  <section class="block" aria-labelledby="chiffres-titre">
    <div class="wrap">
      <h2 id="chiffres-titre">Ce que le marché paie à {{ commune_nom }}</h2>
      <div class="chiffres">
        {% if fiche.gainEc is not null %}
          <div><b data-mesure="gain-ec">+{{ fiche.gainEc }} %</b><span>de E jusqu'à C, en médiane</span></div>
        {% endif %}
        {% if fiche.gainCb is not null %}
          <div><b data-mesure="gain-cb">+{{ fiche.gainCb }} %</b><span>le cran de plus, vers B</span></div>
        {% endif %}
        {% if fiche.prixM2Median is not null %}
          <div><b data-prix-m2>{{ fiche.prixM2Median|number_format(0, ',', ' ') }} €</b><span>prix médian au m²</span></div>
        {% endif %}
      </div>

      <h2>Décote et surcote par étiquette</h2>
      <p>Écart de prix de chaque classe par rapport à un DPE&nbsp;D, à bien comparable — base de la
        plus-value verte à {{ commune_nom }}.</p>
      <table class="grille-dpe">
        <thead>
          <tr><th scope="col">Étiquette</th><th scope="col">Décote / surcote</th>{% if prix_par_classe is not empty %}<th scope="col">Prix au m²</th>{% endif %}</tr>
        </thead>
        <tbody>
          {% for classe, ecart in fiche.decoteSurcote %}
            <tr data-classe="{{ classe }}">
              <td>{{ classe }}</td>
              <td class="val">{{ ecart > 0 ? '+' }}{{ ecart }} %</td>
              {% if prix_par_classe is not empty %}<td class="val">{{ prix_par_classe[classe] is defined ? (prix_par_classe[classe]|number_format(0, ',', ' ')) ~ ' €' : '—' }}</td>{% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <p class="source" data-source>
        Source&nbsp;: ventes DVF (DGFiP) et DPE (ADEME), sous licence ouverte Etalab · millésime {{ fiche.millesime }}
        {%- if fiche.calculeLe %}, calculé le {{ fiche.calculeLe|date('d/m/Y') }}{% endif %}.
        Fiabilité&nbsp;: <span data-fiabilite>{{ fiche.indicateur.libelle }}</span>
        — {{ fiche.n }} vente{{ fiche.n > 1 ? 's' }} retenue{{ fiche.n > 1 ? 's' }}
        {%- if fiche.rayonKm is not null %}, rayon {{ fiche.rayonKm }} km{% endif %},
        erreur médiane {{ fiche.erreurMediane|round }} %.
      </p>

      <div class="cta-row">
        <a href="{{ url('inscription') }}" class="btn" data-lien="inscription">Créer un compte gratuit</a>
        <a href="{{ path('publication') }}" class="btn btn-ghost">Comment c'est mesuré</a>
      </div>
    </div>
  </section>

</main>

{{ include('_pied_de_page.html.twig') }}

</body>
</html>
