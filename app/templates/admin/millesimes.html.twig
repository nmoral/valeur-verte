{% extends 'admin/base.html.twig' %}

{% block title %}Millésimes · Admin interne · Valeur Verte{% endblock %}

{% block admin_title %}Millésimes{% endblock %}

{% block admin_subtitle %}<p>Un millésime calculé n'est <strong>jamais servi automatiquement</strong>. Il est calculé, comparé au précédent, puis activé ici. Publier remplace les coefficients vus par tous les clients ; les rapports déjà émis gardent le leur.</p>{% endblock %}

{% block admin_content %}
    {% if erreur is defined %}
        <p class="erreur" role="alert">{{ erreur }}</p>
    {% endif %}

    {% for message in app.flashes('succes') %}
        <p class="banner banner-ok" role="status">{{ message }}</p>
    {% endfor %}

    <twig:ListeMillesimes />
{% endblock %}
