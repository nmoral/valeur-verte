{% extends 'base.html.twig' %}

{% block title %}Seuil d'essai · Admin interne · Valeur Verte{% endblock %}

{% block body %}
<main class="zone">
    <h1>Seuil d'essai</h1>
    <p>Nombre de rapports offerts avant la bascule payant. Toute modification est tracée au journal d'audit.</p>

    {% if erreur is defined %}
        <p class="erreur" role="alert">{{ erreur }}</p>
    {% endif %}

    <form method="post" action="{{ path('admin_seuil_essai') }}">
        <label for="seuil">Seuil (nombre de rapports)</label>
        <input type="number" id="seuil" name="seuil" min="1" value="{{ seuil }}" required>
        <button type="submit">Enregistrer le seuil</button>
    </form>
</main>
{% endblock %}
