{% extends 'admin/base.html.twig' %}

{% block title %}Audit SEO · Admin interne · Valeur Verte{% endblock %}

{% block admin_title %}Audit SEO{% endblock %}

{% block admin_subtitle %}<p>Contrôle technique et on-page des pages publiques indexables (sitemap + pages hébergées marque blanche) : titres, méta, données structurées, codes HTTP, robots.txt/sitemap.xml. Un instantané est archivé à chaque exécution de <code>app:seo:audit</code>.</p>{% endblock %}

{% block admin_content %}
    {% if dernier is null %}
        <section class="fiche-bloc">
            <p>Aucun audit archivé pour le moment. Lancez la commande <code>app:seo:audit</code> (planifiée le lundi à 01:00 UTC).</p>
        </section>
    {% else %}
        <section class="fiche-bloc">
            <table class="tableau fiche">
                <tbody>
                    <tr><th scope="row">Dernier audit</th><td>{{ dernier.executeLe|date('d/m/Y à H:i') }}</td></tr>
                    <tr><th scope="row">Score technique</th><td><strong>{{ dernier.scoreTechnique }}/100</strong></td></tr>
                    <tr><th scope="row">URL auditées</th><td>{{ dernier.nombreUrls }}</td></tr>
                    <tr><th scope="row">Constats</th><td>{{ dernier.nombreOk }} ok · {{ dernier.nombreAlerte }} alerte(s) · {{ dernier.nombreErreur }} erreur(s)</td></tr>
                </tbody>
            </table>

            {% if tendance|length > 1 %}
                {% set larg = 600 %}
                {% set haut = 80 %}
                {% set n = tendance|length %}
                <figure class="seo-tendance">
                    <figcaption>Tendance du score technique ({{ n }} derniers audits)</figcaption>
                    <svg viewBox="0 0 {{ larg }} {{ haut }}" role="img" aria-label="Évolution du score technique" preserveAspectRatio="none" style="width:100%;max-width:{{ larg }}px;height:{{ haut }}px">
                        <polyline fill="none" stroke="currentColor" stroke-width="2" points="
                            {%- for r in tendance -%}
                                {{ (loop.index0 / (n - 1) * larg)|round(2) }},{{ (haut - r.scoreTechnique / 100 * haut)|round(2) }}{{ ' ' }}
                            {%- endfor -%}
                        " />
                    </svg>
                </figure>
            {% endif %}
        </section>
    {% endif %}

    <twig:ListeRapportsSeo />

    <section class="fiche-bloc">
        <h2>Présence externe</h2>
        <p>Positionnement, indexation et Core Web Vitals collectés auprès de Google Search Console et PageSpeed Insights (<code>app:seo:presence:fetch</code>, lundi 01:30 UTC).</p>

        {% if dernierePresence is null or not dernierePresence.estConfigure %}
            <p><strong>Présence externe non configurée.</strong> Les sources externes (compte de service Search Console, clé PageSpeed) ne sont pas encore provisionnées : la collecte n'archive rien tant que le site n'est pas en ligne et la propriété vérifiée.</p>
        {% else %}
            <table class="tableau fiche">
                <tbody>
                    <tr><th scope="row">Dernière collecte</th><td>{{ dernierePresence.executeLe|date('d/m/Y à H:i') }}</td></tr>
                    <tr><th scope="row">Clics</th><td><strong>{{ dernierePresence.clics|number_format(0, ',', ' ') }}</strong></td></tr>
                    <tr><th scope="row">Impressions</th><td>{{ dernierePresence.impressions|number_format(0, ',', ' ') }}</td></tr>
                    <tr><th scope="row">Position moyenne</th><td>{{ dernierePresence.positionMoyenne is null ? 'n/d' : dernierePresence.positionMoyenne|number_format(1, ',', ' ') }}</td></tr>
                    <tr><th scope="row">URL suivies</th><td>{{ dernierePresence.nombreUrls }}</td></tr>
                </tbody>
            </table>

            {% set pointsClics = tendancePresence|filter(r => r.estConfigure) %}
            {% if pointsClics|length > 1 %}
                {% set larg = 600 %}
                {% set haut = 80 %}
                {% set maxClics = max(pointsClics|map(r => r.clics)) %}
                {% set n = pointsClics|length %}
                <figure class="seo-tendance">
                    <figcaption>Tendance des clics ({{ n }} dernières collectes)</figcaption>
                    <svg viewBox="0 0 {{ larg }} {{ haut }}" role="img" aria-label="Évolution des clics" preserveAspectRatio="none" style="width:100%;max-width:{{ larg }}px;height:{{ haut }}px">
                        <polyline fill="none" stroke="currentColor" stroke-width="2" points="
                            {%- for r in pointsClics -%}
                                {{ (loop.index0 / (n - 1) * larg)|round(2) }},{{ (haut - (maxClics > 0 ? r.clics / maxClics : 0) * haut)|round(2) }}{{ ' ' }}
                            {%- endfor -%}
                        " />
                    </svg>
                </figure>
            {% endif %}
        {% endif %}

        <twig:ListeRapportsPresence />
    </section>
{% endblock %}
