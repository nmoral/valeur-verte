{% extends 'admin/base.html.twig' %}

{% block title %}Comptes · Admin interne · Valeur Verte{% endblock %}

{% block admin_title %}Comptes pro{% endblock %}

{% block admin_subtitle %}<p>Pilotage des comptes : rapports consommés et statut d'essai.</p>{% endblock %}

{% block admin_actions %}<a class="btn" href="{{ path('admin_seuil_essai') }}">Régler le seuil d'essai</a>{% endblock %}

{% block admin_content %}
    <table>
        <thead>
            <tr>
                <th>Compte</th>
                <th>Créé le</th>
                <th>Rapports consommés</th>
                <th>Statut d'essai</th>
            </tr>
        </thead>
        <tbody>
        {% for compte in comptes %}
            <tr>
                <td>{{ compte.identite }}</td>
                <td>{{ compte.creeLe|date('d/m/Y') }}</td>
                <td>{{ compte.rapportsConsommes }} / {{ compte.statut.seuil }}</td>
                <td>
                    {% if compte.statut.seuilAtteint %}
                        Seuil atteint
                    {% else %}
                        En essai — reste {{ compte.statut.rapportsRestants }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun compte pour le moment.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
