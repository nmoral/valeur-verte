{% extends 'base.html.twig' %}

{% block title %}Journal d'audit · Admin interne · Valeur Verte{% endblock %}

{% block body %}
<main class="zone">
    <h1>Journal d'audit</h1>
    <p>Événements sensibles de l'admin interne, les plus récents d'abord.</p>

    <table>
        <thead>
            <tr>
                <th>Quand</th>
                <th>Acteur</th>
                <th>Action</th>
                <th>Cible</th>
            </tr>
        </thead>
        <tbody>
        {% for evenement in evenements %}
            <tr>
                <td>{{ evenement.survenuLe|date('d/m/Y H:i') }}</td>
                <td>{{ evenement.acteur }}</td>
                <td>{{ evenement.action }}</td>
                <td>{{ evenement.cible }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun événement pour le moment.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</main>
{% endblock %}
