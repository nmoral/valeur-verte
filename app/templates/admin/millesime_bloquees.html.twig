{% extends 'admin/base.html.twig' %}

{% block title %}Mailles écartées {{ millesime }} · Admin interne · Valeur Verte{% endblock %}

{% block admin_title %}Mailles écartées — millésime {{ millesime }}{% endblock %}

{% block admin_subtitle %}<p>Ces communes s'écartent de plus de 25 % du millésime précédent (REG-1). Elles n'ont pas été publiées et servent toujours leur valeur antérieure. Débloquer l'une d'elles la met en service après examen — l'action n'est possible qu'une fois le millésime lui-même publié.</p>{% endblock %}

{% block admin_actions %}<a href="{{ path('admin_millesimes') }}">Retour aux millésimes</a>{% endblock %}

{% block admin_content %}
    {% if erreur is defined %}
        <p class="banner banner-bad" role="alert">{{ erreur }}</p>
    {% endif %}

    {% if not millesime_publie %}
        <p class="banner banner-warn" role="status">Il faut d'abord <a href="{{ path('admin_millesimes') }}">publier le millésime {{ millesime }}</a> : débloquer une maille isolée créerait une commune en {{ millesime }} au milieu d'un parc resté au millésime précédent.</p>
    {% endif %}

    {% for message in app.flashes('succes') %}
        <p class="banner banner-ok" role="status">{{ message }}</p>
    {% endfor %}

    <twig:ListeMillesimesBloquees :millesime="millesime" :millesimePublie="millesime_publie" />
{% endblock %}
