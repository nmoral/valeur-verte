<div {{ attributes }}>
    {% embed 'components/_liste_chrome.html.twig' with {
        resultat: this.resultat,
        colonnes: this.colonnes,
        actions: this.actionsGroupees,
        tri: tri,
        direction: direction,
        recherche: recherche,
        selection: selection,
        message: message,
        vide_message: 'Aucune candidature en attente.'
    } %}
        {% block ligne %}
            <td>{{ element.email ?? '—' }}</td>
            <td>#{{ element.tenantId }}</td>
            <td>{{ element.creeLe|date('d/m/Y') }}</td>
            <td class="candidature-actions">
                <form method="post" action="{{ path('admin_candidatures') }}">
                    <input type="hidden" name="tenant" value="{{ element.tenantId }}">
                    <button type="submit" name="action" value="valider" class="btn btn-sm">Valider fondateur</button>
                    <button type="submit" name="action" value="refuser" class="btn btn-ghost btn-sm">Refuser</button>
                </form>
            </td>
        {% endblock %}
    {% endembed %}
</div>
