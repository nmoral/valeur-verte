<!DOCTYPE html>
<html lang="fr">
<head>
{{ include('_seo.html.twig', {
  titre: 'Créer un compte · Valeur Verte',
  og_titre: 'Créez votre compte Valeur Verte',
  description: 'Créez votre compte Valeur Verte : compte actif immédiatement, premier rapport de valeur verte en trois minutes, sans carte bancaire.',
  canonical: url('inscription'),
}) }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/auth.css') }}">
</head>
<body>
<main class="auth">
  <a href="/" class="auth-brand"><i aria-hidden="true">VV</i> Valeur Verte</a>

  <div class="auth-card">
    <h1>Créer votre compte</h1>
    <p class="auth-lead">Compte actif immédiatement. Premier rapport en trois minutes, sans carte bancaire.</p>

    {% if erreurs.global is defined %}
      <p class="alert" role="alert">{{ erreurs.global }}</p>
    {% endif %}

    <form method="post" action="{{ path('inscription') }}" novalidate>
      <div class="field-group{{ erreurs.email is defined ? ' has-error' : '' }}">
        <label for="email">Email professionnel</label>
        <input type="email" id="email" name="email" value="{{ email }}" autocomplete="email" required autofocus>
        {% if erreurs.email is defined %}<span class="form-error">{{ erreurs.email }}</span>{% endif %}
      </div>

      <div class="field-group{{ erreurs.password is defined ? ' has-error' : '' }}">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" autocomplete="new-password" required>
        {% if erreurs.password is defined %}
          <span class="form-error">{{ erreurs.password }}</span>
        {% else %}
          <span class="hint">Au moins 8 caractères.</span>
        {% endif %}
      </div>

      <div class="field-group{{ erreurs.siret is defined ? ' has-error' : '' }}">
        <label for="siret">SIRET</label>
        <input type="text" id="siret" name="siret" value="{{ siret }}" inputmode="numeric" maxlength="14" placeholder="14 chiffres">
        {% if erreurs.siret is defined %}
          <span class="form-error">{{ erreurs.siret }}</span>
        {% else %}
          <span class="hint">Pour retrouver votre entreprise et vos qualifications. Ne bloque pas la création.</span>
        {% endif %}
      </div>

      <div id="entreprise-apercu" class="entreprise-apercu" hidden aria-live="polite">
        <p class="entreprise-apercu-titre">Votre entreprise</p>
        <p class="entreprise-nom" data-champ="raisonSociale"></p>
        <p class="entreprise-adresse" data-champ="adresse"></p>
        <p class="entreprise-meta"><span data-champ="codeNaf"></span> · <span data-champ="effectif"></span></p>
        <p class="entreprise-rge"><span class="entreprise-badge" data-champ="statutRgeLibelle"></span> <span data-champ="domainesRge"></span></p>
      </div>
      <p id="entreprise-repli" class="hint" hidden>Entreprise introuvable pour ce SIRET — vous pourrez compléter votre fiche plus tard.</p>

      <div class="field-cgu field-group{{ erreurs.cgu is defined ? ' has-error' : '' }}">
        <label for="cgu">
          <input type="checkbox" id="cgu" name="cgu" value="1"{{ erreurs.cgu is not defined and cgu_accepte ? ' checked' : '' }}>
          <span>J'accepte les <a href="{{ path('cgu') }}" target="_blank" rel="noopener">conditions générales d'utilisation</a>
          et les <a href="{{ path('cgv') }}" target="_blank" rel="noopener">conditions générales de vente</a>.</span>
        </label>
        {% if erreurs.cgu is defined %}<span class="form-error">{{ erreurs.cgu }}</span>{% endif %}
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('inscription') }}">
      <button type="submit" class="btn-primary">Créer mon compte</button>
    </form>

    <p class="auth-note">Vérification d'email a posteriori · Résiliation en un clic</p>
  </div>

  <p class="auth-alt">Vous avez déjà un compte ? <a href="{{ path('login') }}">Se connecter</a></p>
  <p class="auth-legal">Estimation statistique — ne constitue pas une évaluation immobilière.</p>
</main>
<script src="{{ asset('js/inscription-siret.js') }}" defer></script>
</body>
</html>
