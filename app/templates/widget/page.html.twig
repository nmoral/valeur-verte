{% extends 'widget/base.html.twig' %}

{% block contenu %}
    {# Parcours particulier (#41, §4) : adresse → surfaces → DPE. L'autocomplétion
       (#287) renseigne le champ caché `code_insee` depuis l'adresse choisie dans
       la liste — sans lui, aucune commune, donc aucun chiffre. Le mur de contact
       ne vient jamais ici : d'abord le premier chiffre. #}
    <section class="carte">
        <p class="surtitre">Estimation de la valeur verte</p>
        <h1 class="titre">Ce que la rénovation ajoute à la valeur de votre maison</h1>
        <p class="accroche">
            Un chiffre fondé sur les ventes réelles de votre commune, en une minute et sans engagement.
        </p>

        <form data-widget="estimation" method="post" action="/{{ token }}/estimation"
              data-parcours-url="/{{ token }}/evenement"
              data-adresse-url="/{{ token }}/adresses">
            {{ include('widget/_piege.html.twig') }}
            {{ include('widget/_turnstile.html.twig') }}
            <input type="hidden" name="jeton_chargement" value="{{ jeton_chargement }}">
            {# Visite en cours (#90) : identifiant anonyme et éphémère, porté par le
               formulaire — pas de cookie, pas de stockage navigateur. #}
            <input type="hidden" name="session_parcours" value="{{ session_parcours }}">
            <input type="hidden" name="code_insee" value="{{ valeurs.code_insee|default('') }}">

            {% if erreurs|default([]) is not empty %}
                <ul class="erreurs" data-widget="erreurs">
                    {% for erreur in erreurs %}
                        <li>{{ erreur }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="champ">
                <label for="adresse">Adresse du bien</label>
                {# Combobox : la liste est peuplée par `widget_adresse.js`, et reste vide
                   (donc masquée) sans JavaScript. #}
                <input type="text" id="adresse" name="adresse" data-parcours="adresse" data-adresse="champ"
                       autocomplete="off" role="combobox" aria-autocomplete="list"
                       aria-controls="adresse-suggestions" aria-expanded="false"
                       placeholder="12 rue du Taur, Toulouse"
                       value="{{ valeurs.adresse|default('') }}" required>
                <ul class="suggestions" id="adresse-suggestions" data-adresse="suggestions" role="listbox" hidden></ul>
                <p class="champ-aide">Choisissez votre adresse dans la liste : elle situe le bien dans sa commune.</p>
            </div>

            <div class="duo">
                <div class="champ">
                    <label for="surface_batie">Surface habitable (m²)</label>
                    <input type="number" id="surface_batie" name="surface_batie" min="20" max="400"
                           placeholder="95" value="{{ valeurs.surface_batie|default('') }}" required>
                </div>

                <div class="champ">
                    <label for="surface_terrain">Surface du terrain (m²)</label>
                    <input type="number" id="surface_terrain" name="surface_terrain" min="0" max="10000"
                           value="{{ valeurs.surface_terrain|default('0') }}">
                </div>
            </div>

            <p class="champ-titre">Étiquette énergétique</p>
            <div class="dpe-duo">
                <div class="champ">
                    <label for="dpe_avant">DPE actuel</label>
                    <select id="dpe_avant" name="dpe_avant">
                        {% for dpe in dpe_options %}
                            <option value="{{ dpe.value }}" {{ valeurs.dpe_avant|default('') == dpe.value ? 'selected' : '' }}>{{ dpe.value }}</option>
                        {% endfor %}
                    </select>
                </div>

                <span class="fleche" aria-hidden="true">→</span>

                <div class="champ">
                    <label for="dpe_apres">DPE visé après travaux</label>
                    <select id="dpe_apres" name="dpe_apres">
                        {% for dpe in dpe_options %}
                            <option value="{{ dpe.value }}" {{ valeurs.dpe_apres|default('C') == dpe.value ? 'selected' : '' }}>{{ dpe.value }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <button class="bouton" type="submit">Estimer la valeur verte</button>
        </form>
    </section>
{% endblock %}
