{# Gabarit commun aux pages légales (#228) : même habillage que la vitrine, un
   contenu en prose. Les blocs `titre`, `description` et `route` sont fournis par
   chaque page. #}
<!DOCTYPE html>
<html lang="fr">
<head>
{{ include('_seo.html.twig', {
  titre: block('titre_seo')|trim ~ ' — Valeur Verte',
  description: block('description_seo')|trim,
  canonical: url(block('route')|trim),
}) }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/landing.css') }}">
</head>
<body>

<a href="#contenu" class="sr-only">Aller au contenu principal</a>

{{ include('_nav_publique.html.twig') }}

<main id="contenu" class="legal">
  <div class="wrap">
    <h1>{% block titre %}{% endblock %}</h1>
    {% block chapeau %}{% endblock %}
    {% block contenu %}{% endblock %}
  </div>
</main>

{{ include('_pied_de_page.html.twig') }}

</body>
</html>
