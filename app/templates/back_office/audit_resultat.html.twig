{% extends 'back_office/base.html.twig' %}

{% block page_subtitle %}<p>Le chiffre, toujours accompagné de son contexte et de sa fiabilité.</p>{% endblock %}

{% block topbar_actions %}<a class="btn btn-ghost btn-sm" href="{{ path('back_office_audit') }}">Nouvelle saisie</a>{% endblock %}

{% block stylesheets %}
<style>
    .resultat{max-width:680px;padding:0;overflow:hidden}
    .resultat-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:20px 24px;border-bottom:1px solid var(--rule)}
    .resultat-eyebrow{font:500 12px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em;text-transform:uppercase;color:var(--mute);margin:0 0 6px}
    .resultat-adresse{font:500 19px/1.3 'Public Sans',sans-serif;color:var(--ink);margin:0}
    .resultat-bien{font:13px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--mute);margin:5px 0 0}
    .resultat-dpe{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .resultat-dpe .arrow{color:var(--mute)}
    .resultat-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;padding:24px}
    .hero-montant{font:600 44px/1 'Public Sans',sans-serif;color:var(--brand);letter-spacing:-.01em;margin:0}
    .hero-contexte{font:14px/1.5 'Public Sans',sans-serif;color:var(--slate);margin:12px 0 0;max-width:44ch}
    .fiabilite{display:inline-flex;align-items:center;gap:9px;border-radius:999px;padding:8px 15px;font:500 14px/1 'Public Sans',sans-serif;border:1px solid transparent;white-space:nowrap}
    .fiabilite-pastille{width:12px;height:12px;border-radius:50%;flex-shrink:0}
    .fiabilite-vert{background:#E7F4EC;border-color:#BFE3CF;color:var(--green)}
    .fiabilite-vert .fiabilite-pastille{background:var(--ok)}
    .fiabilite-orange{background:#FCF2DF;border-color:#F0DBAE;color:#8A5712}
    .fiabilite-orange .fiabilite-pastille{background:var(--warn)}
    .fiabilite-rouge{background:var(--danger-soft);border-color:#F0C9C3;color:var(--danger)}
    .fiabilite-rouge .fiabilite-pastille{background:var(--danger)}
    .banner-fiabilite{margin:0 24px 20px}
    .banner-bande{border:1px solid var(--rule);background:#F6F8FA;color:var(--slate)}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
    .stat{padding:14px 24px;min-width:0}
    .stat + .stat{border-left:1px solid var(--rule)}
    .stat-k{display:block;font:12px/1.3 'Public Sans',sans-serif;color:var(--mute);margin-bottom:3px}
    .stat-v{font:500 18px/1.2 'Public Sans',sans-serif;color:var(--ink)}
    .infobulle{position:relative;display:inline-flex;vertical-align:middle;margin-left:4px}
    .infobulle-marque{width:15px;height:15px;padding:0;border-radius:50%;border:1px solid var(--rule-strong,#c9c9c9);background:#fff;color:var(--mute);font:600 10px/1 'Public Sans',sans-serif;cursor:help;display:inline-flex;align-items:center;justify-content:center}
    .infobulle-marque:hover,.infobulle-marque:focus-visible{background:var(--ink,#222);color:#fff;border-color:var(--ink,#222);outline:none}
    .infobulle-bulle{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);z-index:20;width:max-content;max-width:230px;padding:8px 10px;border-radius:4px;background:var(--ink,#222);color:#fff;font:400 12.5px/1.45 'Public Sans',sans-serif;text-align:left;box-shadow:0 4px 14px rgba(0,0,0,.18);visibility:hidden;opacity:0;transition:opacity .12s ease}
    .infobulle:hover .infobulle-bulle,.infobulle-marque:focus-visible + .infobulle-bulle{visibility:visible;opacity:1}
    .resultat-bouquet{padding:14px 24px;border-top:1px solid var(--rule)}
    .resultat-bouquet-k{display:block;font:12px/1.3 'Public Sans',sans-serif;color:var(--mute);margin-bottom:3px}
    .resultat-bouquet-nom{font:500 16px/1.3 'Public Sans',sans-serif;color:var(--ink)}
    .resultat-bouquet-postes{display:block;font:12.5px/1.5 'Public Sans',sans-serif;color:var(--slate);margin-top:2px}
    .resultat-prix{text-align:center;padding:16px 24px;font:14px/1.5 'Public Sans',sans-serif;color:var(--slate);margin:0}
    .resultat-prix strong{color:var(--ink);font-weight:500}
    .resultat-prix .origine{color:var(--mute)}

    .effet-seuil{border-top:1px solid var(--rule);padding:18px 24px}
    .effet-seuil h2{font:600 15px/1.3 'Public Sans',sans-serif;color:var(--ink);margin:0 0 12px}
    .effet-seuil-table{width:100%;border-collapse:collapse}
    .effet-seuil-table th{text-align:left;font:500 11px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em;text-transform:uppercase;color:var(--mute);padding:0 0 8px;border-bottom:1px solid var(--rule)}
    .effet-seuil-table th:last-child{text-align:right}
    .effet-seuil-table td{padding:9px 0;font:14px/1.4 'Public Sans',sans-serif;color:var(--slate);border-bottom:1px solid var(--rule)}
    .effet-seuil-table td.montant{text-align:right;font:500 15px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--ink);white-space:nowrap}
    .effet-seuil-table .palier-seuil td{color:var(--ink);font-weight:600;background:var(--brand-soft, #eef6f4)}
    .effet-seuil-table .palier-seuil td.montant{color:var(--brand)}
    .palier-tag{display:inline-block;margin-left:6px;font:500 11px/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--brand);border:1px solid var(--brand);border-radius:999px;padding:3px 7px;vertical-align:middle}
    .effet-seuil-message{margin:12px 0 0;font:14px/1.55 'Public Sans',sans-serif;color:var(--slate)}
    .resultat-indispo{margin:24px}
    .ajustement{border-top:1px solid var(--rule);padding:18px 24px}
    .ajustement-lignes{width:100%;border-collapse:collapse;margin-bottom:4px}
    .ajustement-lignes td{padding:9px 0;font:14px/1.4 'Public Sans',sans-serif;color:var(--slate);vertical-align:baseline}
    .ajustement-lignes td.montant{text-align:right;font:500 15px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--ink);white-space:nowrap;padding-left:20px}
    .ajustement-lignes .mesure td{border-bottom:1px solid var(--rule)}
    .ajustement-lignes .ajust td{color:var(--mute)}
    .ajustement-lignes .retenue td{border-top:2px solid var(--ink);font-weight:500;color:var(--ink);padding-top:11px}
    .ajustement-lignes .retenue td.montant{font-size:18px;color:var(--brand)}
    .ajustement-motif{color:var(--mute)}
    .ajustement-form{margin-top:6px}
    .ajustement-form summary{cursor:pointer;font:500 14px/1.4 'Public Sans',sans-serif;color:var(--slate)}
    .ajustement-form .champs{display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end;margin:14px 0 6px}
    .ajustement-form label{display:block;font:12px/1.3 'Public Sans',sans-serif;color:var(--mute);margin-bottom:4px}
    .ajustement-form input,.ajustement-form textarea,.ajustement-form select{font:14px/1.4 'Public Sans',sans-serif;border:1px solid var(--rule);border-radius:6px;padding:8px 10px;background:#fff;color:var(--ink)}
    .rac-menage{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:14px 0 2px}
    .rac-menage label{margin:0;font:500 13px/1.3 'Public Sans',sans-serif;color:var(--ink)}
    .rac-menage select{min-width:210px}
    .ajustement-form .motif-champ{flex:1;min-width:220px}
    .ajustement-form .motif-champ input{width:100%}
    .ajustement-erreur{color:var(--danger);font:13px/1.4 'Public Sans',sans-serif;margin:0 0 10px}
    .ajustement-note{color:var(--mute);font:12px/1.5 'Public Sans',sans-serif;margin:10px 0 0}
    .resultat-actions{display:flex;gap:10px;flex-wrap:wrap;padding:18px 24px 22px;border-top:1px solid var(--rule)}
    .personnaliser{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:0 24px 18px;padding:12px 16px;border:1px solid var(--rule);border-radius:8px;background:var(--brand-soft,#f4f8f6)}
    .personnaliser p{margin:0;font:13.5px/1.5 'Public Sans',sans-serif;color:var(--slate)}
    .personnaliser a{color:var(--brand);font-weight:500}
    .btn[disabled]{opacity:.55;cursor:not-allowed}
    .btn .soon{margin-left:8px;font-size:11px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:var(--mute)}
    .bloc{border-top:1px solid var(--rule)}
    .bloc-titre{font:600 11px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);margin:0;padding:16px 24px 0}
    .bloc-valeur{background:linear-gradient(180deg,var(--brand-soft,#f4f8f6),transparent 140px)}
    .bloc-valeur .resultat-hero{padding-top:14px}
    .empty-valeur{margin:12px 24px 20px;padding:18px 20px;border:1px dashed var(--rule-strong,#c9c9c9);border-radius:10px;background:#fff}
    .empty-valeur-titre{margin:0 0 6px;font:600 16px/1.3 'Public Sans',sans-serif;color:var(--ink)}
    .empty-valeur-note{margin:0;font:13.5px/1.55 'Public Sans',sans-serif;color:var(--slate);max-width:62ch}
    .override-couts{margin:16px 0 4px}
    .override-couts>summary{cursor:pointer;font:500 13px/1.4 'Public Sans',sans-serif;color:var(--brand);list-style:none;padding:6px 0}
    .override-couts>summary::-webkit-details-marker{display:none}
    .override-couts>summary::before{content:'▸ ';color:var(--mute)}
    .override-couts[open]>summary::before{content:'▾ '}
    /* Section coût / reste à charge : aligner sur les 24px du reste et aérer. */
    .declarations{padding:6px 24px 16px}
    .declarations button[type=submit]{margin-top:18px}
    /* « Signaler ce chiffre » : une pastille discrète plutôt qu'un lien nu. */
    .signalement{margin:6px 24px 24px}
    .signalement>summary{display:inline-flex;align-items:center;gap:7px;cursor:pointer;font:500 13px/1 'Public Sans',sans-serif;color:var(--slate);list-style:none;padding:9px 14px;border:1px solid var(--rule);border-radius:999px;background:#fff;transition:border-color .12s ease,color .12s ease}
    .signalement>summary:hover{border-color:var(--rule-strong,#c9c9c9);color:var(--ink)}
    .signalement>summary::-webkit-details-marker{display:none}
    .signalement>summary::before{content:'⚑';color:var(--mute);font-size:12px}
    .signalement[open]>summary{margin-bottom:14px}
    .signalement form{display:flex;flex-direction:column;gap:9px;max-width:520px}
    .signalement label{font:12px/1.4 'Public Sans',sans-serif;color:var(--mute)}
    .signalement textarea{font:14px/1.5 'Public Sans',sans-serif;border:1px solid var(--rule);border-radius:6px;padding:9px 11px}
    .signalement button{align-self:flex-start}
</style>
{% endblock %}

{% block bo_content %}
<div class="panel resultat">
    <div class="resultat-head">
        <div>
            <p class="resultat-eyebrow">Restitution · mode audit</p>
            <h2 class="resultat-adresse">{{ saisie.adresse }}</h2>
            <p class="resultat-bien">{{ saisie.surfaceBatie }} m² bâti · {{ saisie.surfaceTerrain }} m² terrain{% if saisie.nombrePieces %} · {{ saisie.nombrePieces }} pièces{% endif %}</p>
        </div>
        <div class="resultat-dpe">
            <span class="dpe d-{{ saisie.dpeAvant.value|lower }}">{{ saisie.dpeAvant.value }}</span>
            <span class="arrow">→</span>
            <span class="dpe d-{{ saisie.dpeApres.value|lower }}">{{ saisie.dpeApres.value }}</span>
        </div>
    </div>

    {% if bouquet %}
        <div class="resultat-bouquet">
            <span class="resultat-bouquet-k">Travaux retenus</span>
            <span class="resultat-bouquet-nom">{{ bouquet.nom }}</span>
            <span class="resultat-bouquet-postes">{% for poste in bouquet.postes %}{{ poste.libelle }}{{ not loop.last ? ' · ' }}{% endfor %}</span>
        </div>
    {% endif %}

    {% for avertissement in avertissements %}
        <p class="banner banner-warn resultat-indispo" role="alert">{{ avertissement }}</p>
    {% endfor %}

    <section class="bloc bloc-valeur" aria-labelledby="bloc-valeur-titre">
        <h2 class="bloc-titre" id="bloc-valeur-titre">Valeur verte créée par la rénovation</h2>
    {% if restitution %}
        {% set fiabilite = restitution.fiabilite %}
        <div class="resultat-hero">
            <div>
                <p class="hero-montant">+{{ restitution.montantEuros|number_format(0, ',', ' ') }} €</p>
                <p class="hero-contexte">fourchette {{ restitution.borneBasseEuros|number_format(0, ',', ' ') }} € – {{ restitution.borneHauteEuros|number_format(0, ',', ' ') }} € <twig:Infobulle texte="La fourchette exprime la marge d'incertitude de l'estimation : la valeur réelle se situe très probablement à l'intérieur." /></p>
            </div>
            <span class="fiabilite fiabilite-{{ fiabilite.couleur }}">
                <span class="fiabilite-pastille" aria-hidden="true"></span>Fiabilité {{ fiabilite.libelle|lower }}
            </span>
        </div>

        {% if fiabilite.exigeBandeau %}
            <p class="banner banner-bad banner-fiabilite" role="alert">Estimation fragile&nbsp;: effectif réduit ou estimation élargie au-delà de la commune. À interpréter avec prudence.</p>
        {% endif %}

        {% if restitution.estDegradee %}
            <p class="banner banner-warn banner-degrade banner-fiabilite" role="alert">Estimation dégradée&nbsp;: marge d'erreur élevée (20 à 30&nbsp;%). Le chiffre reste indicatif.</p>
        {% endif %}

        {% if restitution.bandesAppliquees is not empty %}
            <p class="banner banner-bande banner-fiabilite" role="note">{% for classe, bande in restitution.bandesAppliquees %}La classe {{ classe }} est estimée via la bande {{ bande }}.{% if not loop.last %} {% endif %}{% endfor %}</p>
        {% endif %}

        <div class="stats">
            <div class="stat"><span class="stat-k">Transactions <twig:Infobulle texte="Nombre de ventes comparables retenues pour l'estimation. Plus il y en a, plus l'estimation est fiable." /></span><span class="stat-v">{{ restitution.n|number_format(0, ',', ' ') }}</span></div>
            <div class="stat"><span class="stat-k">Rayon retenu <twig:Infobulle texte="Zone autour du bien dans laquelle les ventes comparables ont été retenues. Un petit rayon reflète un marché très local." /></span><span class="stat-v">{{ restitution.intitulePortee }}</span></div>
            <div class="stat"><span class="stat-k">Millésime <twig:Infobulle texte="L'année de référence des ventes utilisées pour l'estimation." /></span><span class="stat-v">{{ restitution.millesime }}</span></div>
        </div>

        <p class="resultat-prix">Prix de base&nbsp;: <strong>{{ restitution.prixBaseEuros|number_format(0, ',', ' ') }} €</strong> <span class="origine">({{ restitution.prixSaisiParLePro ? 'valeur que vous avez saisie' : 'médiane de la commune' }})</span>{% if not restitution.prixSaisiParLePro %} <twig:Infobulle texte="Le prix médian des ventes de la commune : la moitié des ventes sont au-dessus, la moitié en dessous. Moins sensible aux valeurs extrêmes qu'une moyenne." />{% endif %}</p>

        {% if effet_de_seuil %}
            <section class="effet-seuil" aria-labelledby="effet-seuil-titre">
                <h2 id="effet-seuil-titre">Le marché paie surtout le passage en classe C</h2>
                <table class="effet-seuil-table">
                    <thead>
                        <tr><th scope="col">Rénovation visée</th><th scope="col">Valeur verte créée</th></tr>
                    </thead>
                    <tbody>
                        {% for palier in effet_de_seuil.paliers %}
                            <tr class="palier{{ palier.estSeuil ? ' palier-seuil' : '' }}{{ palier.estCible ? ' palier-cible' : '' }}">
                                <td>{{ saisie.dpeAvant.value }}&nbsp;→&nbsp;{{ palier.classeCible.value }}{% if palier.estCible %} <span class="palier-tag">votre objectif</span>{% endif %}</td>
                                <td class="montant">+{{ palier.gainEuros|number_format(0, ',', ' ') }}&nbsp;€</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p class="effet-seuil-message">{{ effet_de_seuil.message }}</p>
            </section>
        {% endif %}

        <div class="ajustement">
            {% if ajustement %}
                <table class="ajustement-lignes">
                    <tr class="mesure">
                        <td>Valeur verte mesurée <span class="ajustement-motif">({{ saisie.dpeAvant.value }}→{{ saisie.dpeApres.value }}, {{ restitution.n|number_format(0, ',', ' ') }} ventes, {{ restitution.rayonKm ? 'rayon ' ~ restitution.rayonKm ~ ' km' : 'départemental' }})</span></td>
                        <td class="montant">+{{ restitution.montantEuros|number_format(0, ',', ' ') }} €</td>
                    </tr>
                    <tr class="ajust">
                        <td>Ajustement du professionnel <span class="ajustement-motif">— {{ ajustement.motif }}</span></td>
                        <td class="montant">{{ ajustement.montantEuros < 0 ? '−' : '+' }}{{ ajustement.montantEuros|abs|number_format(0, ',', ' ') }} €</td>
                    </tr>
                    <tr class="retenue">
                        <td>Estimation retenue</td>
                        <td class="montant">+{{ ajustement.estimationRetenue(restitution.montantEuros)|number_format(0, ',', ' ') }} €</td>
                    </tr>
                </table>
                <p class="ajustement-note">Notre mesure reste affichée intacte. L'ajustement, sous votre responsabilité, est attribué au professionnel dans le PDF.</p>
            {% endif %}

            <details class="ajustement-form"{% if erreur_ajustement %} open{% endif %}>
                <summary>{{ ajustement ? 'Modifier l’ajustement' : 'Ajouter un ajustement du professionnel' }}</summary>
                {% if erreur_ajustement %}<p class="ajustement-erreur" role="alert">{{ erreur_ajustement }}</p>{% endif %}
                <form method="post" action="{{ path('back_office_audit_resultat') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('ajustement') }}">
                    <div class="champs">
                        <div>
                            <label for="ajustement_montant">Montant (négatif ou positif)</label>
                            <input type="number" id="ajustement_montant" name="montant" step="1" value="{{ montant_saisi ?? (ajustement ? ajustement.montantEuros) }}" required>
                        </div>
                        <div class="motif-champ">
                            <label for="ajustement_motif">Motif (obligatoire)</label>
                            <input type="text" id="ajustement_motif" name="motif" value="{{ motif_saisi ?? (ajustement ? ajustement.motif) }}" maxlength="255" required>
                        </div>
                        <button type="submit" class="btn btn-sm">Appliquer</button>
                    </div>
                </form>
            </details>
        </div>
    {% else %}
        <div class="empty-valeur banner-indisponible" role="note">
            <p class="empty-valeur-titre">Estimation indisponible pour cette commune</p>
            <p class="empty-valeur-note">La commune est hors couverture, ou les ventes comparables sont trop peu nombreuses pour un chiffre fiable. Votre saisie reste enregistrée&nbsp;: le rapport PDF et le reste à charge ci-dessous restent disponibles.</p>
        </div>
    {% endif %}
    </section>

    <section class="bloc bloc-cout" aria-labelledby="bloc-cout-titre">
        <h2 class="bloc-titre" id="bloc-cout-titre">Coût de la rénovation &amp; reste à charge</h2>
        <div class="declarations">
            {% include 'back_office/_reste_a_charge.html.twig' %}

            {% if erreur_declarations %}
                <p class="ajustement-erreur" role="alert">{{ erreur_declarations }}</p>
            {% endif %}

            <form method="post" action="{{ path('back_office_audit_resultat_declarations') }}" class="ajustement-form">
                <div class="rac-menage">
                    <label for="categorie_revenu">Situation du ménage <twig:Infobulle texte="Sert à estimer MaPrimeRénov'. Les plafonds portent sur le revenu fiscal de référence du foyer et dépendent du nombre de personnes et de la région — hors Île-de-France, un foyer de 2 personnes est « très modeste » jusqu'à 25 393 €, « modeste » jusqu'à 32 553 €, « intermédiaire » jusqu'à 45 842 €. Sous réserve d'instruction par l'Anah." /></label>
                    <select id="categorie_revenu" name="categorie_revenu">
                        <option value="NonPrecisee">Non précisée</option>
                        {% for categorie in categories_revenu %}
                            <option value="{{ categorie.name }}"{{ declarations.categorieRevenu == categorie ? ' selected' : '' }}>{{ categorie.libelle }}</option>
                        {% endfor %}
                    </select>
                </div>

                {% if bouquet %}
                    <details class="override-couts">
                        <summary>Ajuster les coûts poste par poste</summary>
                        <p class="ajustement-note">Remplacez le coût issu de votre grille par vos devis, poste par poste.</p>
                        <div class="champs">
                            {% for poste in bouquet.postes %}
                                <div>
                                    <label for="chiffrage_{{ poste.name }}">{{ poste.libelle }} (€ HT)</label>
                                    <input type="number" id="chiffrage_{{ poste.name }}" name="chiffrage[{{ poste.name }}]" min="0" step="100">
                                </div>
                            {% endfor %}
                        </div>
                    </details>
                {% endif %}

                <button type="submit" class="btn btn-sm">Mettre à jour</button>
            </form>
        </div>
    </section>

    <div class="resultat-actions">
        <a class="btn" href="{{ path('back_office_audit_pdf') }}">Télécharger le PDF</a>
        <a class="btn btn-ghost" href="{{ path('back_office_audit') }}">Nouvelle saisie</a>
    </div>

    {# ONB-4 : invitation à personnaliser après le rapport, jamais un mur — on peut reporter. #}
    <div class="personnaliser" role="note">
        <p>Votre rapport est prêt et téléchargeable en l'état. Quand vous le souhaitez, personnalisez
            <a href="{{ path('back_office_marque') }}">votre marque</a> et
            <a href="{{ path('back_office_couts') }}">vos coûts</a>.</p>
        <button type="button" class="btn btn-ghost btn-sm" data-fermer-personnaliser>Plus tard</button>
    </div>

    <details class="signalement">
        <summary>Signaler ce chiffre</summary>
        <form data-async method="post" action="{{ path('back_office_audit_signalement') }}">
            <label for="signalement_message">Ce chiffre vous semble faux ? Dites-nous ce qui cloche (optionnel).</label>
            <textarea id="signalement_message" name="message" rows="3"></textarea>
            <button type="submit" class="btn btn-sm">Envoyer le signalement</button>
            <span class="feedback" role="status" aria-live="polite"></span>
        </form>
    </details>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.querySelectorAll('[data-fermer-personnaliser]').forEach(function (bouton) {
        bouton.addEventListener('click', function () {
            var invitation = bouton.closest('.personnaliser');
            if (invitation) {
                invitation.remove();
            }
        });
    });

    document.querySelectorAll('form[data-async]').forEach(function (form) {
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            var feedback = form.querySelector('.feedback');
            feedback.textContent = 'Envoi…';
            feedback.className = 'feedback';

            fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form)
            })
                .then(function (response) {
                    return response.json().then(function (data) {
                        return { ok: response.ok, data: data };
                    });
                })
                .then(function (resultat) {
                    if (resultat.ok && resultat.data.ok) {
                        feedback.textContent = 'Merci, c\'est noté ✓';
                        feedback.className = 'feedback ok';
                        form.querySelector('button[type="submit"]').disabled = true;
                    } else {
                        feedback.textContent = (resultat.data && resultat.data.erreur) || 'Envoi impossible';
                        feedback.className = 'feedback erreur';
                    }
                })
                .catch(function () {
                    feedback.textContent = 'Erreur réseau';
                    feedback.className = 'feedback erreur';
                });
        });
    });
</script>
{% endblock %}
