{% extends 'back_office/base.html.twig' %}

{% block page_subtitle %}<p>Le chiffre, toujours accompagné de son contexte et de sa fiabilité.</p>{% endblock %}

{% block topbar_actions %}<a class="btn btn-ghost btn-sm" href="{{ path('back_office_audit') }}">Nouvelle saisie</a>{% endblock %}

{% block stylesheets %}
<style>
    .resultat{max-width:680px;padding:0;overflow:hidden}
    .resultat-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:20px 24px;border-bottom:1px solid var(--rule)}
    .resultat-eyebrow{font:500 12px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em;text-transform:uppercase;color:var(--mute);margin:0 0 6px}
    .resultat-adresse{font:500 19px/1.3 'Public Sans',sans-serif;color:var(--ink);margin:0}
    .resultat-bien{font:13px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--mute);margin:5px 0 0}
    .resultat-dpe{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .resultat-dpe .arrow{color:var(--mute)}
    .resultat-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;padding:24px}
    .hero-label{font:13px/1.4 'Public Sans',sans-serif;color:var(--mute);margin:0 0 6px}
    .hero-montant{font:600 44px/1 'Public Sans',sans-serif;color:var(--brand);letter-spacing:-.01em;margin:0}
    .hero-contexte{font:14px/1.5 'Public Sans',sans-serif;color:var(--slate);margin:12px 0 0;max-width:44ch}
    .fiabilite{display:inline-flex;align-items:center;gap:9px;border-radius:999px;padding:8px 15px;font:500 14px/1 'Public Sans',sans-serif;border:1px solid transparent;white-space:nowrap}
    .fiabilite-pastille{width:12px;height:12px;border-radius:50%;flex-shrink:0}
    .fiabilite-vert{background:#E7F4EC;border-color:#BFE3CF;color:var(--green)}
    .fiabilite-vert .fiabilite-pastille{background:var(--ok)}
    .fiabilite-orange{background:#FCF2DF;border-color:#F0DBAE;color:#8A5712}
    .fiabilite-orange .fiabilite-pastille{background:var(--warn)}
    .fiabilite-rouge{background:var(--danger-soft);border-color:#F0C9C3;color:var(--danger)}
    .fiabilite-rouge .fiabilite-pastille{background:var(--danger)}
    .banner-fiabilite{margin:0 24px 20px}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
    .stat{padding:14px 24px;min-width:0}
    .stat + .stat{border-left:1px solid var(--rule)}
    .stat-k{display:block;font:12px/1.3 'Public Sans',sans-serif;color:var(--mute);margin-bottom:3px}
    .stat-v{font:500 18px/1.2 'Public Sans',sans-serif;color:var(--ink)}
    .resultat-prix{text-align:center;padding:16px 24px;font:14px/1.5 'Public Sans',sans-serif;color:var(--slate);margin:0}
    .resultat-prix strong{color:var(--ink);font-weight:500}
    .resultat-prix .origine{color:var(--mute)}
    .resultat-indispo{margin:24px}
    .resultat-actions{display:flex;gap:10px;flex-wrap:wrap;padding:18px 24px 22px;border-top:1px solid var(--rule)}
    .btn[disabled]{opacity:.55;cursor:not-allowed}
    .btn .soon{margin-left:8px;font-size:11px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:var(--mute)}
</style>
{% endblock %}

{% block bo_content %}
<div class="panel resultat">
    <div class="resultat-head">
        <div>
            <p class="resultat-eyebrow">Restitution · mode audit</p>
            <h2 class="resultat-adresse">{{ saisie.adresse }}</h2>
            <p class="resultat-bien">{{ saisie.surfaceBatie }} m² bâti · {{ saisie.surfaceTerrain }} m² terrain{% if saisie.nombrePieces %} · {{ saisie.nombrePieces }} pièces{% endif %}</p>
        </div>
        <div class="resultat-dpe">
            <span class="dpe d-{{ saisie.dpeAvant.value|lower }}">{{ saisie.dpeAvant.value }}</span>
            <span class="arrow">→</span>
            <span class="dpe d-{{ saisie.dpeApres.value|lower }}">{{ saisie.dpeApres.value }}</span>
        </div>
    </div>

    {% for avertissement in avertissements %}
        <p class="banner banner-warn resultat-indispo" role="alert">{{ avertissement }}</p>
    {% endfor %}

    {% if restitution %}
        {% set fiabilite = restitution.fiabilite %}
        <div class="resultat-hero">
            <div>
                <p class="hero-label">Valeur verte créée par la rénovation</p>
                <p class="hero-montant">+{{ restitution.montantEuros|number_format(0, ',', ' ') }} €</p>
                <p class="hero-contexte">fourchette {{ restitution.borneBasseEuros|number_format(0, ',', ' ') }} € – {{ restitution.borneHauteEuros|number_format(0, ',', ' ') }} €</p>
            </div>
            <span class="fiabilite fiabilite-{{ fiabilite.couleur }}">
                <span class="fiabilite-pastille" aria-hidden="true"></span>Fiabilité {{ fiabilite.libelle|lower }}
            </span>
        </div>

        {% if fiabilite.exigeBandeau %}
            <p class="banner banner-bad banner-fiabilite" role="alert">Estimation fragile&nbsp;: effectif réduit ou repli départemental. À interpréter avec prudence.</p>
        {% endif %}

        <div class="stats">
            <div class="stat"><span class="stat-k">Transactions</span><span class="stat-v">{{ restitution.n|number_format(0, ',', ' ') }}</span></div>
            <div class="stat"><span class="stat-k">Rayon retenu</span><span class="stat-v">{{ restitution.rayonKm ? restitution.rayonKm ~ ' km' : 'départemental' }}</span></div>
            <div class="stat"><span class="stat-k">Millésime</span><span class="stat-v">{{ restitution.millesime }}</span></div>
        </div>

        <p class="resultat-prix">Prix de base&nbsp;: <strong>{{ restitution.prixBaseEuros|number_format(0, ',', ' ') }} €</strong> <span class="origine">({{ restitution.prixSaisiParLePro ? 'valeur que vous avez saisie' : 'médiane de la commune' }})</span></p>
    {% else %}
        <p class="banner banner-warn banner-indisponible resultat-indispo" role="alert">Estimation indisponible pour cette commune (hors couverture ou données insuffisantes). La saisie reste enregistrée.</p>
    {% endif %}

    <div class="resultat-actions">
        <a class="btn" href="{{ path('back_office_audit_pdf') }}">Télécharger le PDF</a>
        <a class="btn btn-ghost" href="{{ path('back_office_audit') }}">Nouvelle saisie</a>
    </div>

    <details class="signalement">
        <summary>Signaler ce chiffre</summary>
        <form data-async method="post" action="{{ path('back_office_audit_signalement') }}">
            <label for="signalement_message">Ce chiffre vous semble faux ? Dites-nous ce qui cloche (optionnel).</label>
            <textarea id="signalement_message" name="message" rows="3"></textarea>
            <button type="submit">Envoyer le signalement</button>
            <span class="feedback" role="status" aria-live="polite"></span>
        </form>
    </details>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.querySelectorAll('form[data-async]').forEach(function (form) {
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            var feedback = form.querySelector('.feedback');
            feedback.textContent = 'Envoi…';
            feedback.className = 'feedback';

            fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form)
            })
                .then(function (response) {
                    return response.json().then(function (data) {
                        return { ok: response.ok, data: data };
                    });
                })
                .then(function (resultat) {
                    if (resultat.ok && resultat.data.ok) {
                        feedback.textContent = 'Merci, c\'est noté ✓';
                        feedback.className = 'feedback ok';
                        form.querySelector('button[type="submit"]').disabled = true;
                    } else {
                        feedback.textContent = (resultat.data && resultat.data.erreur) || 'Envoi impossible';
                        feedback.className = 'feedback erreur';
                    }
                })
                .catch(function () {
                    feedback.textContent = 'Erreur réseau';
                    feedback.className = 'feedback erreur';
                });
        });
    });
</script>
{% endblock %}
