{% extends 'back_office/base.html.twig' %}

{% block page_subtitle %}<p>L'adresse que vous partagez à vos clients — hébergée par nous, à vos couleurs.</p>{% endblock %}

{% block stylesheets %}
<style>
    .pp-lien{display:flex;gap:8px;align-items:center;max-width:640px}
    .pp-lien input{flex:1;font:13px/1.4 'JetBrains Mono',monospace;border:1px solid var(--rule);border-radius:6px;padding:9px 11px;color:var(--ink);background:#fff}
    .pp-etat{display:inline-flex;align-items:center;gap:7px;font:500 13px/1.3 'Public Sans',sans-serif}
    .pp-etat::before{content:'';width:9px;height:9px;border-radius:50%;background:var(--ok)}
    .pp-etat.est-retiree::before{background:var(--rule-strong)}
    .pp-masque{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    .pp-note{font:13px/1.5 'Public Sans',sans-serif;color:var(--slate);max-width:640px;margin:12px 0 0}
    .pp-erreur{margin:0 0 12px;padding:10px 12px;border:1px solid var(--bad);border-radius:2px;color:var(--bad);font-size:13px}
    .pp-slug{display:flex;gap:8px;align-items:flex-end;max-width:640px;margin-top:14px}
    .pp-slug label{font:500 13px/1.3 'Public Sans',sans-serif;color:var(--ink);display:block;margin-bottom:6px}
    .pp-slug input{flex:1;font:14px/1.4 'Public Sans',sans-serif;border:1px solid var(--rule);border-radius:6px;padding:9px 11px}
</style>
{% endblock %}

{% block bo_content %}
<div class="panel">
    <div class="panel-head">
        <h2>Votre lien public</h2>
        <span class="pp-etat{{ page.estActive ? '' : ' est-retiree' }}" data-etat>{{ page.estActive ? 'en ligne' : 'retirée' }}</span>
    </div>

    {% if erreur %}<p class="pp-erreur" role="alert" data-erreur>{{ erreur }}</p>{% endif %}

    <div class="pp-lien">
        <label class="pp-masque" for="pp-lien-champ">Adresse de votre page publique</label>
        <input type="text" id="pp-lien-champ" value="{{ lien }}" readonly>
        <button type="button" class="btn" data-copier data-lien="{{ lien }}">Copier</button>
    </div>

    <form class="pp-slug" method="post" action="{{ path('back_office_page_publique_slug') }}">
        <div style="flex:1">
            <label for="pp-slug">Nom affiché dans le lien</label>
            <input type="text" id="pp-slug" name="slug" value="{{ page.slug }}" maxlength="{{ longueur_max_slug }}">
        </div>
        <button type="submit" class="btn">Renommer</button>
    </form>
    <p class="pp-note">
        Ce nom n'est qu'un habillage : les liens déjà partagés continuent de fonctionner
        après un renommage.
    </p>

    <form method="post" action="{{ path(page.estActive ? 'back_office_page_publique_retirer' : 'back_office_page_publique_remettre') }}" style="margin-top:14px">
        <button type="submit" class="btn{{ page.estActive ? ' btn-ghost' : '' }}">
            {{ page.estActive ? 'Retirer la page' : 'Remettre la page en ligne' }}
        </button>
        <span class="pp-note" style="display:inline-block;margin-left:10px">
            {{ page.estActive
                ? 'Une fois retirée, votre adresse publique répondra « page introuvable ».'
                : 'Votre adresse publique répond « page introuvable » tant qu\'elle est retirée.' }}
        </span>
    </form>

    <form method="post" action="{{ path('back_office_page_publique_regenerer') }}" style="margin-top:14px">
        <button type="submit" class="btn btn-ghost btn-sm" data-confirmer="Régénérer le lien coupe définitivement l'adresse actuelle : tous les liens déjà partagés cesseront de fonctionner. Continuer ?">
            Régénérer le lien
        </button>
        <span class="pp-note" style="display:inline-block;margin-left:10px">
            En cas de fuite ou de fin de contrat : l'adresse actuelle est coupée sur-le-champ et
            ne revient pas.
        </span>
    </form>

    <p class="pp-note">
        Cette page <strong>ne consomme pas</strong> votre essai : seuls les audits que vous
        réalisez décomptent votre quota. Vous pouvez diffuser ce lien sans compter.
    </p>
    <p class="pp-note">
        L'apparence de la page — logo, couleur, mentions — suit votre marque :
        <a href="{{ path('back_office_marque') }}">modifier ma marque</a>.
    </p>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.querySelectorAll('[data-confirmer]').forEach(function (bouton) {
        bouton.addEventListener('click', function (evenement) {
            if (!window.confirm(bouton.dataset.confirmer)) {
                evenement.preventDefault();
            }
        });
    });

    document.querySelectorAll('[data-copier]').forEach(function (bouton) {
        bouton.addEventListener('click', function () {
            navigator.clipboard.writeText(bouton.dataset.lien).then(function () {
                var libelle = bouton.textContent;
                bouton.textContent = 'Copié';
                setTimeout(function () { bouton.textContent = libelle; }, 2000);
            });
        });
    });
</script>
{% endblock %}
