{% extends 'base.html.twig' %}

{% block title %}{{ page_title|default('Back-office') }} · Valeur Verte{% endblock %}

{% block body %}
<div class="app">
    <aside>
        <div class="brand"><i>VV</i> {% block brand %}Valeur Verte{% endblock %}</div>
        <nav class="side">
            <a href="{{ path('espace_pro') }}"{{ nav_active|default('') == 'dashboard' ? ' class="on"' : '' }}>Tableau de bord</a>
            <a href="{{ path('back_office_audit') }}"{{ nav_active|default('') == 'audit' ? ' class="on"' : '' }}>Nouvel audit</a>
            <a href="{{ path('back_office_rapports') }}"{{ nav_active|default('') == 'reports' ? ' class="on"' : '' }}>Rapports &amp; leads</a>
            <p class="sect">Configuration</p>
            <a href="{{ path('back_office_couts') }}"{{ nav_active|default('') == 'costs' ? ' class="on"' : '' }}>Coûts de travaux</a>
            <a href="{{ path('back_office_bouquets') }}"{{ nav_active|default('') == 'bouquets' ? ' class="on"' : '' }}>Bouquets types</a>
            <a href="{{ path('back_office_marque') }}"{{ nav_active|default('') == 'branding' ? ' class="on"' : '' }}>Ma marque</a>
            <span class="lien-off" title="À venir">Page publique</span>
            <p class="sect">Compte</p>
            <span class="lien-off" title="À venir">Abonnement</span>
            <span class="lien-off" title="À venir">Entreprise</span>
        </nav>
        {% block sidebar_footer %}{% endblock %}
        <div class="side-footer">
            <a href="{{ path('logout') }}" class="side-logout"><span aria-hidden="true">⏻</span> Se déconnecter</a>
        </div>
    </aside>

    <main>
        <div class="top">
            <div>
                <h1>{{ page_title|default('') }}</h1>
                {% block page_subtitle %}{% endblock %}
            </div>
            <div style="display:flex;gap:8px">{% block topbar_actions %}{% endblock %}</div>
        </div>

        {% block bo_content %}{% endblock %}
    </main>
</div>
{% endblock %}
