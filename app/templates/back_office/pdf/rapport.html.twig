{% apply spaceless %}
{% set couleur = branding.couleurPrincipale.hex %}
<html>
<head>
<style>
    body{font-family:sans-serif;color:#1a2b2f;font-size:12px;line-height:1.5}
    h1,h2,h3,p{margin:0}
    .bandeau{background:{{ couleur }};color:#ffffff;padding:11px 20px}
    .bandeau .logo{width:38px;height:38px}
    .bandeau .marque{font-size:17px;font-weight:bold;vertical-align:middle}
    .bandeau .meta{color:#ffffff;font-size:10px;text-align:right;line-height:1.6}
    .corps{padding:12px 20px}
    .eyebrow{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#6b7c80}
    .adresse{font-size:18px;font-weight:bold;margin-top:3px}
    .bien{color:#6b7c80;margin-top:3px}
    .section-titre{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#6b7c80;font-weight:bold;margin-top:10px;border-top:1px solid #dfe6e7;padding-top:7px}
    .bouquet{margin-top:10px;padding:8px 12px;border:1px solid #dfe6e7;border-radius:3px;background:#f7faf9}
    .bouquet-k{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#6b7c80}
    .bouquet-nom{font-weight:bold;margin-top:2px}
    .bouquet-postes{color:#6b7c80;margin-top:3px}
    .hero{margin-top:8px}
    .hero-label{color:#6b7c80}
    .montant{font-size:27px;font-weight:bold;color:{{ couleur }};margin-top:2px}
    .fourchette{color:#41585d;margin-top:3px}
    .fiabilite{margin-top:5px;font-weight:bold}
    .fiabilite-solide{color:#1a7a43}
    .fiabilite-correct{color:#8a5712}
    .fiabilite-fragile{color:#b4271f}
    .bandeau-alerte{margin-top:12px;padding:10px 12px;border:1px solid #f0c9c3;background:#fbecea;color:#b4271f;border-radius:3px}
    .bandeau-info{margin-top:12px;padding:10px 12px;border:1px solid #f0dbae;background:#fcf2df;color:#8a5712;border-radius:3px}
    table.stats{width:100%;margin-top:10px;border-collapse:collapse}
    table.stats td{width:33%;padding:7px 12px;border:1px solid #dfe6e7}
    .stat-k{color:#6b7c80;font-size:10px;text-transform:uppercase}
    .stat-v{font-size:15px;font-weight:bold}
    .prix{margin-top:10px;color:#41585d}
    /* Lignes coût / aides (include partagé, classes .ajustement-lignes / .montant). */
    table.ajustement-lignes{width:100%;margin-top:8px;border-collapse:collapse}
    table.ajustement-lignes td{padding:6px 0;color:#41585d;font-size:12px}
    table.ajustement-lignes td.montant{text-align:right;font-weight:bold;color:#1a2b2f;white-space:nowrap;font-size:13px}
    table.ajustement-lignes tr.mesure td{border-bottom:1px solid #dfe6e7}
    table.ajustement-lignes tr.ajust td{color:#6b7c80}
    table.ajustement-lignes tr.retenue td{border-top:2px solid #1a2b2f;font-weight:bold;color:#1a2b2f;font-size:14px}
    .ajustement-motif{color:#6b7c80;font-weight:normal}
    .rac-note,.menage{margin-top:7px;color:#41585d;font-size:11px}
    table.effet-seuil{width:100%;margin-top:10px;border-collapse:collapse}
    table.effet-seuil td{padding:6px 10px;color:#41585d;border-bottom:1px solid #dfe6e7}
    table.effet-seuil td.m{text-align:right;font-weight:bold;color:#1a2b2f;white-space:nowrap}
    table.effet-seuil tr.titre td{font-weight:bold;color:#1a2b2f;border-bottom:2px solid #1a2b2f;padding-left:0}
    table.effet-seuil tr.palier-seuil td{background:#eef6f4;color:#0e4a5c;font-weight:bold}
    .effet-seuil-message{margin-top:6px;font-size:11px;color:#41585d}
    table.ajustement{width:100%;margin-top:14px;border-collapse:collapse}
    table.ajustement td{padding:7px 0;color:#41585d}
    table.ajustement td.m{text-align:right;font-weight:bold;color:#1a2b2f;white-space:nowrap}
    table.ajustement tr.mesure td{border-bottom:1px solid #dfe6e7}
    table.ajustement tr.retenue td{border-top:2px solid #1a2b2f;font-weight:bold;color:#1a2b2f}
    table.ajustement .motif{color:#6b7c80}
    .ajustement-note{margin-top:6px;font-size:10px;color:#6b7c80}
    .methode{margin-top:6px;color:#41585d;font-size:11px;line-height:1.45}
    .mention{margin-top:7px;padding:7px 11px;border:1px solid #dfe6e7;border-radius:3px;background:#f7faf9;color:#41585d;font-size:10px;line-height:1.45}
    .identite{margin-top:4px}
    .identite .l{padding:2px 0;color:#41585d}
    .pied{font-size:9px;color:#6b7c80;border-top:1px solid #dfe6e7;padding-top:6px}
</style>
</head>
<body>

<htmlpagefooter name="pied">
    <div class="pied">
        Rapport {{ reference }} · valeur-verte · établi à partir de données publiques (DVF, ADEME)
    </div>
</htmlpagefooter>
<sethtmlpagefooter name="pied" value="on" />

<table width="100%" class="bandeau" cellpadding="0" cellspacing="0"><tr>
    <td width="52">
        {% if branding.logoUrl %}<img class="logo" src="{{ branding.logoUrl }}" alt="logo" width="40" height="40">{% endif %}
    </td>
    <td><span class="marque">Valeur Verte</span></td>
    <td class="meta">Réf. {{ reference }}{% if date %}<br>{{ date|date('d/m/Y') }}{% endif %}</td>
</tr></table>

<div class="corps">
    <p class="eyebrow">Rapport de valeur verte · mode audit</p>
    <p class="adresse">{{ saisie.adresse }}</p>
    <p class="bien">{{ saisie.surfaceBatie }} m² bâti · {{ saisie.surfaceTerrain }} m² terrain{% if saisie.nombrePieces %} · {{ saisie.nombrePieces }} pièces{% endif %} · DPE {{ dpe_badge(saisie.dpeAvant.value) }} → {{ dpe_badge(saisie.dpeApres.value) }}</p>

    {% if bouquet %}
        <div class="bouquet">
            <div class="bouquet-k">Travaux retenus</div>
            <div class="bouquet-nom">{{ bouquet.nom }}</div>
            <div class="bouquet-postes">{% for poste in bouquet.postes %}{{ poste.libelle }}{{ not loop.last ? ' · ' }}{% endfor %}</div>
        </div>
    {% endif %}

    {% for avertissement in avertissements %}
        <div class="bandeau-info">{{ avertissement }}</div>
    {% endfor %}

    {# 1. La valeur verte créée — le livrable, en tête. #}
    <p class="section-titre">Valeur verte créée par la rénovation</p>
    {% if restitution %}
        {% set fiabilite = restitution.fiabilite %}
        <div class="hero">
            <p class="montant">+{{ restitution.montantEuros|number_format(0, ',', ' ') }} €</p>
            <p class="fourchette">fourchette {{ restitution.borneBasseEuros|number_format(0, ',', ' ') }} € – {{ restitution.borneHauteEuros|number_format(0, ',', ' ') }} €</p>
            <p class="fiabilite fiabilite-{{ fiabilite.couleur }}">Fiabilité : {{ fiabilite.libelle }}</p>
        </div>

        {% if fiabilite.exigeBandeau %}
            <div class="bandeau-alerte">Estimation fragile : effectif réduit ou estimation élargie au-delà de la commune. À interpréter avec prudence.</div>
        {% endif %}

        {% if restitution.estDegradee %}
            <div class="bandeau-info">Estimation dégradée : marge d'erreur élevée (20 à 30 %). Le chiffre reste indicatif.</div>
        {% endif %}

        {% if restitution.bandesAppliquees is not empty %}
            <div class="bandeau-info">{% for classe, bande in restitution.bandesAppliquees %}La classe {{ classe }} est estimée via la bande {{ bande }}.{% if not loop.last %} {% endif %}{% endfor %}</div>
        {% endif %}

        <table class="stats" cellpadding="0" cellspacing="0"><tr>
            <td><span class="stat-k">Transactions</span><br><span class="stat-v">{{ restitution.n|number_format(0, ',', ' ') }}</span></td>
            <td><span class="stat-k">Rayon retenu</span><br><span class="stat-v">{{ restitution.intitulePortee }}</span></td>
            <td><span class="stat-k">Millésime</span><br><span class="stat-v">{{ restitution.millesime }}</span></td>
        </tr></table>

        <p class="prix">Prix de base : <strong>{{ restitution.prixBaseEuros|number_format(0, ',', ' ') }} €</strong>
            ({{ restitution.prixSaisiParLePro ? 'valeur saisie par le professionnel' : 'médiane des ventes de la commune' }})</p>

        {% if effet_de_seuil %}
            <table class="effet-seuil" cellpadding="0" cellspacing="0">
                <tr class="titre"><td colspan="2">Le marché paie surtout le passage en classe C</td></tr>
                {% for palier in effet_de_seuil.paliers %}
                    <tr class="palier{{ palier.estSeuil ? ' palier-seuil' : '' }}{{ palier.estCible ? ' palier-cible' : '' }}">
                        <td>{{ saisie.dpeAvant.value }} → {{ palier.classeCible.value }}{% if palier.estCible %} (votre objectif){% endif %}</td>
                        <td class="m">+{{ palier.gainEuros|number_format(0, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
            </table>
            <p class="effet-seuil-message">{{ effet_de_seuil.message }}</p>
        {% endif %}

        {% if ajustement %}
            <table class="ajustement" cellpadding="0" cellspacing="0">
                <tr class="mesure">
                    <td>Valeur verte mesurée <span class="motif">({{ saisie.dpeAvant.value }}→{{ saisie.dpeApres.value }}, {{ restitution.n|number_format(0, ',', ' ') }} ventes, {{ restitution.rayonKm ? 'rayon ' ~ restitution.rayonKm ~ ' km' : 'départemental' }})</span></td>
                    <td class="m">+{{ restitution.montantEuros|number_format(0, ',', ' ') }} €</td>
                </tr>
                <tr class="ajust">
                    <td>Ajustement du professionnel <span class="motif">— {{ ajustement.motif }}</span></td>
                    <td class="m">{{ ajustement.montantEuros < 0 ? '−' : '+' }}{{ ajustement.montantEuros|abs|number_format(0, ',', ' ') }} €</td>
                </tr>
                <tr class="retenue">
                    <td>Estimation retenue</td>
                    <td class="m">+{{ ajustement.estimationRetenue(restitution.montantEuros)|number_format(0, ',', ' ') }} €</td>
                </tr>
            </table>
            <p class="ajustement-note">Ligne d'ajustement établie sous la responsabilité du professionnel. La valeur verte mesurée reste inchangée.</p>
        {% endif %}
    {% else %}
        <div class="bandeau-alerte">Estimation indisponible pour cette commune (hors couverture ou données insuffisantes). Le coût de la rénovation et le reste à charge ci-dessous restent établis.</div>
    {% endif %}

    {# 2. Coût de la rénovation & reste à charge. #}
    {% if reste_a_charge %}
        <p class="section-titre">Coût de la rénovation &amp; reste à charge</p>
        {% include 'back_office/_reste_a_charge.html.twig' %}
    {% endif %}
    {% if situation_menage %}<p class="menage">Situation du ménage retenue : <strong>{{ situation_menage }}</strong>.</p>{% endif %}

    {# 3. Méthode & cadre. #}
    <p class="section-titre">Méthode &amp; sources</p>
    <p class="methode">La valeur verte est estimée par comparaison avec des <strong>ventes comparables</strong> (base DVF) appariées à leur diagnostic de performance énergétique (ADEME), dans un rayon adaptatif autour du bien. Le nombre de transactions retenues (n), le rayon et le millésime des ventes situent la robustesse de l'estimation ; l'indicateur de fiabilité — Solide, Correct ou Fragile — en synthétise l'effectif et l'étendue géographique.</p>
    <p class="mention">Estimation statistique établie à partir de données publiques (DVF, ADEME). Elle <strong>ne constitue pas une évaluation immobilière</strong> au sens réglementaire, ni un engagement sur le prix de vente ou sur le montant des aides, soumis à instruction par l'Anah.</p>

    {% if branding.numeroRge or branding.telephone or branding.mentionsLegales %}
        <p class="section-titre">Le professionnel</p>
        <div class="identite">
            {% if branding.numeroRge %}<div class="l">Numéro RGE : {{ branding.numeroRge }}</div>{% endif %}
            {% if branding.telephone %}<div class="l">Téléphone : {{ branding.telephone }}</div>{% endif %}
            {% if branding.mentionsLegales %}<div class="l">{{ branding.mentionsLegales }}</div>{% endif %}
        </div>
    {% endif %}
</div>

</body>
</html>
{% endapply %}
