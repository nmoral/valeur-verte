# Configuration du moteur de calcul — copier en `.env` et ajuster au besoin.
#
# Toutes les variables VV_MOTEUR_* sont OPTIONNELLES : absente ou vide, chacune
# retombe sur sa valeur historique (comportement inchangé). Elles servent à régler
# le moteur par expérience sans toucher au code (cf. docs/REVUE-STRATEGIES-CALCUL.md).

# Connexion PostgreSQL (requise pour ingest/compute/migrate).
DATABASE_URL=postgresql://valeur_verte:valeur_verte@localhost:5432/valeur_verte

# ── Sélection de l'échantillon ──
# Paliers du rayon adaptatif, en km, séparés par des virgules (S17).
VV_MOTEUR_RADII_KM=10,15,20,30,50
# Seuil d'arrêt du rayon : nombre de ventes visé (S17).
VV_MOTEUR_MIN_SAMPLE=80
# Bascule en mode dégradé départemental sous ce nombre de ventes locales (S18).
VV_MOTEUR_MIN_LOCAL_SAMPLE=30
# Effectif minimal d'une classe DPE pour publier son coefficient (S21).
VV_MOTEUR_MIN_CLASS_SAMPLE=20
# Nombre minimal de classes publiées pour ne pas refuser la maille (S21).
VV_MOTEUR_MIN_CLASSES_PUBLIEES=2
# Segment de biens retenu (S15).
VV_MOTEUR_SEGMENT=Maison

# ── Régression ──
# σ de la pondération gaussienne, en km — utilisé si SIGMA_MODE=fixe (S23).
VV_MOTEUR_SIGMA_KM=10
# Mode de σ en local : "fixe" | "rayon" (σ=rayon/diviseur) | "densite"
# (σ = distance à la 80e vente la plus proche / diviseur — densité continue). S23.
VV_MOTEUR_SIGMA_MODE=densite
VV_MOTEUR_SIGMA_DIVISEUR=1.0
# Plancher de σ (km) : protège les mailles fragiles d'un σ trop serré.
VV_MOTEUR_SIGMA_MIN=3.0
# σ du mode départemental (quasi non pondéré), en km (S18).
VV_MOTEUR_DEPARTEMENTAL_SIGMA_KM=1000
# Classe DPE de référence (S22).
VV_MOTEUR_REFERENCE_DPE=D
# Nombre de voisines de l'indice local de quartier (S24).
VV_MOTEUR_VOISINS_INDICE_LOCAL=20
# Étendue géographique minimale (en degrés) sous laquelle l'indice est neutre (S24).
VV_MOTEUR_ETENDUE_MINIMALE_INDICE=0.002
# Effets fixes commune dans la régression (S22). false = les retirer (l'indice
# local et la pondération portent déjà la localité) — fiabilise le rural.
VV_MOTEUR_EFFETS_FIXES_COMMUNE=false
# Indice local de quartier comme régresseur (S24). Gardé (le retirer dégrade la
# prédiction) — complémentaire de la pondération, pas redondant.
VV_MOTEUR_INDICE_LOCAL=true

# ── Validation croisée ──
# Nombre de plis (S28).
VV_MOTEUR_CV_FOLDS=5

# ── Éligibilité de l'échantillon ──
# Restreindre la régression au bâti ancien < 1989 (S20). false = le bâti récent
# entre aussi (un logement récent en E doit compter).
VV_MOTEUR_RESTREINDRE_BATI_ANCIEN=false

# ── Écrêtage de l'échantillon au calcul (S32) ──
# "off" | "residu" : retire les biens au résidu pondéré aberrant (troncature robuste).
VV_MOTEUR_ECRETAGE=residu
# N'écrête qu'au-dessus de cet effectif éligible.
VV_MOTEUR_ECRETAGE_SEUIL_N=100
# Seuil en nombre de MAD sur le résidu pondéré au-delà duquel une vente est retirée.
VV_MOTEUR_ECRETAGE_K=3.0

# ── Nettoyage à l'ingestion (S12) ──
VV_MOTEUR_PRICE_MIN=30000
VV_MOTEUR_PRICE_MAX=900000
VV_MOTEUR_BATI_MIN=50
VV_MOTEUR_BATI_MAX=250
VV_MOTEUR_TERRAIN_MIN=50
VV_MOTEUR_TERRAIN_MAX=5000
