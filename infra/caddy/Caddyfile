{
	email admin@valeur-verte.fr
}

# www -> apex : une seule adresse canonique (sans www).
www.valeur-verte.fr {
	redir https://valeur-verte.fr{uri} permanent
}

# Point d'entrée public : TLS auto (Let's Encrypt), HTTP->HTTPS, basic auth + noindex,
# puis proxy vers le conteneur app (HTTP interne). L'app route par sous-domaine
# (app.=espace pro, admin.=admin interne, widget.=widget public) via APP_DOMAINE.
valeur-verte.fr, app.valeur-verte.fr, admin.valeur-verte.fr, widget.valeur-verte.fr {
	encode zstd gzip

	# Preview non public : interdire l'indexation (en plus du 401 basic auth).
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

	# robots.txt servi sans auth (fichier monté) : interdiction totale.
	@robots path /robots.txt
	handle @robots {
		header Content-Type "text/plain; charset=utf-8"
		root * /etc/caddy
		file_server
	}

	# Santé applicative (#313) : servie **sans** basic auth. Le VPS peut tomber en
	# entier — la sonde du conteneur ne le verra jamais, seule une surveillance
	# externe le voit, et derrière un 401 elle ne mesurerait que le 401. L'endpoint
	# ne livre rien d'exploitable : un « ok »/« ko » par contrôle, pas de version,
	# pas de trace. Placé avant la porte : Caddy évalue les « handle » dans l'ordre.
	@sante path /sante
	handle @sante {
		# Le runtime signe ses réponses (« FrankenPHP Caddy », version exacte de PHP) :
		# on les retire ici, la route étant la seule ouverte sans authentification.
		header -Server
		header -X-Powered-By
		reverse_proxy app:80
	}

	# Tout le reste : gate basic auth (équivalent htaccess) -> proxy vers app.
	# Hash bcrypt inline (pas via env : Compose interpole les $ du hash et le casse).
	# Gate de preview privé (mot de passe aléatoire fort, bcrypt coût 14) sur dépôt
	# privé ; à déplacer vers un secret / à retirer à l'ouverture publique du site.
	handle {
		basic_auth {
			vv $2a$14$derpNf6CMOrgDM6wNUrvCeiNX.LEB0YwtaQIFuEITRyEVJReE1dUW
		}
		reverse_proxy app:80
	}

	# App injoignable (conteneur arrêté, crash, redéploiement) : Caddy renvoie
	# une passerelle 502/503/504 que l'app ne peut habiller elle-même. On sert
	# alors une page statique autonome (#197). Tant que l'app répond, ses propres
	# pages d'erreur passent telles quelles ; seul l'échec de passerelle atterrit ici.
	handle_errors {
		root * /etc/caddy
		rewrite * /erreur-indisponible.html
		header Content-Type "text/html; charset=utf-8"
		header Retry-After "120"
		file_server
	}
}
